# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID чата беседы (для голосования и драфта). Для теста — ID лички (узнать через @userinfobot)
GROUP_CHAT_ID=

# URL core (в Docker — http://core:8000)
CORE_URL=http://core:8000

# CSV-экспорт Google Sheets с игроками (опционально)
# PLAYERS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=0

# Админы — никнеймы Telegram без @, через запятую
ADMIN_USERNAMES=user1,user2
