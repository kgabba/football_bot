# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID чата беседы (для опроса и отправки составов). Узнать: переслать сообщение из чата в @userinfobot
GROUP_CHAT_ID=

# Опционально: ID темы (топика) в супергруппе с темами — опрос и сообщения уйдут в эту тему
# GROUP_TOPIC_ID=

# URL core (в Docker — http://core:8000)
CORE_URL=http://core:8000

# CSV-экспорт Google Sheets с игроками (опционально)
# PLAYERS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=0

# Админы — через запятую: `username` (или `@username`) и/или числовой Telegram `user_id`.
ADMIN_USERNAMES=user1,user2
